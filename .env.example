# ============================================================
#  Copie ce fichier en .env et choisis UN des deux modes.
# ============================================================

# ----- MODE A : 100% HORS-LIGNE (aucune connexion) ----------
# Base Postgres embarquée dans l'app (données sur CE poste
# uniquement, pas de partage entre postes). Décommente :
# VITE_LOCAL_MODE=true

# ----- MODE B : EN LIGNE / PARTAGÉ (Supabase) ---------------
# Données partagées entre tous les postes (équipe).
# Projet Supabase > Settings > API :
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...votre_cle_anon

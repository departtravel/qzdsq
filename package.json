{
  "name": "qzdsq-fleet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application de gestion de flotte de véhicules",
  "author": "Depart Travel Services",
  "repository": "https://github.com/departtravel/qzdsq",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:desktop": "cross-env ELECTRON=1 tsc -b && cross-env ELECTRON=1 vite build",
    "build:pages": "cross-env PAGES=1 tsc -b && cross-env PAGES=1 vite build",
    "build:single": "cross-env SINGLEFILE=1 tsc -b && cross-env SINGLEFILE=1 vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win --x64",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:linux": "npm run build:desktop && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.dts.controlegasoil",
    "productName": "Controle Gasoil",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "public/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "public/icons/icon-512.png"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.0.5",
    "wait-on": "^8.0.1"
  }
}
